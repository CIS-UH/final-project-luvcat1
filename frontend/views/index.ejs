<!DOCTYPE html>
<html lang="en">

<h2>Members</h2>

<form action="/members/add" method="POST">
  <input name="name" placeholder="Name">
  <input name="details" placeholder="Details">
  <input name="title" placeholder="Title">
  <input name="level" placeholder="Level">
  <button>Add</button>
</form>

<ul>
    <% members.forEach(m => { %>
      <li>
        <%= m.name %> - <%= m.title %>

        <form action="/members/delete/<%= m.id %>" method="POST">
          <button>Delete</button>
        </form>
      </li>
    <% }) %>
</ul>

<ul>
<% members.forEach(m => { %>
  <li>
    <form action="/members/update/<%= m.id %>" method="POST">
      <input name="name" value="<%= m.name %>">
      <input name="details" value="<%= m.details %>">
      <input name="title" value="<%= m.title %>">
      <input name="level" value="<%= m.level %>">

      <button type="submit">Update</button>
    </form>

    <form action="/members/delete/<%= m.id %>" method="POST">
      <button>Delete</button>
    </form>
  </li>
<% }) %>
</ul>

<h2>Events</h2>

<form action="/events/add" method="POST">
  <input name="name" placeholder="Event Name">
  <input name="capacity" placeholder="Capacity">
  <input name="level" placeholder="Level">
  <input name="date" placeholder="YYYY-MM-DD">
  <button>Add Event</button>
</form>

<ul>
<% events.forEach(e => { %>
  <li>
    <form action="/events/update/<%= e.id %>" method="POST">
      <input name="name" value="<%= e.name %>">
      <input name="capacity" value="<%= e.capacity %>">
      <input name="level" value="<%= e.level %>">
      <input name="date" value="<%= e.date %>">

      <button>Update</button>
    </form>

    <form action="/events/delete/<%= e.id %>" method="POST">
      <button>Delete</button>
    </form>
  </li>
<% }) %>
</ul>

<h2>Registrations</h2>

<form action="/registrations/add" method="POST">
  <input name="member_id" placeholder="Member ID">
  <input name="event_id" placeholder="Event ID">
  <button>Register</button>
</form>

<ul>
<% registrations.forEach(r => { %>
  <li>
    Member <%= r.member_id %> → Event <%= r.event_id %>

    <form action="/registrations/delete/<%= r.id %>" method="POST">
      <button>Cancel</button>
    </form>
  </li>
<% }) %>
</ul>

</html>
